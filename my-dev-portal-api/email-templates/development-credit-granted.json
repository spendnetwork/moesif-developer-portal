{
  "subject": "Your Open Opportunities development credit is ready",
  "text": "Hello {{name}},\n\nGood news - your invitation has been accepted and {{company}}'s development credit is ready to use.\n\nGBP {{creditAmount}} in development credit has been added to your account. It's valid for {{validityDays}} days and expires {{creditExpiresAt}}, metered at Basic rates.\n\nOpen your developer portal to view your balance and manage API keys:\n{{portalUrl}}\n\nQuestions? Contact welcome@openopps.com.\n\nOpen Opportunities",
  "html": "<!doctype html><html><body style=\"margin:0;background:#f4f6f5;color:#243632;font-family:Arial,Helvetica,sans-serif\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td align=\"center\" style=\"padding:32px 16px\"><table role=\"presentation\" width=\"560\" style=\"width:100%;max-width:560px;background:#ffffff;border:1px solid #e5e7eb;border-radius:12px\" cellpadding=\"0\" cellspacing=\"0\"><tr><td style=\"background:#034737;padding:28px 32px;border-radius:12px 12px 0 0\"><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\"><tr><td style=\"width:36px;height:36px;line-height:36px;background:#ffffff;border-radius:50%;text-align:center;font-size:16px;font-weight:bold;color:#034737\">O</td><td style=\"padding-left:12px;color:#ffffff;font-size:18px;font-weight:bold\">Open Opportunities</td></tr></table></td></tr><tr><td style=\"padding:36px 32px 12px\"><h1 style=\"margin:0 0 16px;font-size:21px;line-height:1.3;color:#16241f\">Your development credit is ready</h1><p style=\"margin:0 0 14px;line-height:1.6;font-size:14px;color:#3f5850\">Hello {{name}},</p><p style=\"margin:0 0 18px;line-height:1.6;font-size:14px;color:#3f5850\">Good news - your invitation has been accepted and {{company}}'s development credit is ready to use.</p><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:0 0 22px\"><tr><td style=\"background:#f0f4ef;border-radius:8px;padding:18px;text-align:center\"><p style=\"margin:0 0 4px;font-size:26px;font-weight:bold;color:#034737\">GBP {{creditAmount}}</p><p style=\"margin:0;font-size:13px;color:#2f4a3c;line-height:1.6\">Development credit valid for {{validityDays}} days, expires {{creditExpiresAt}}. Metered at Basic rates.</p></td></tr></table><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:0 0 8px\"><tr><td style=\"border-radius:6px;background:#034737\"><a href=\"{{portalUrl}}\" style=\"display:inline-block;padding:12px 24px;color:#ffffff;font-size:15px;font-weight:bold;text-decoration:none\">Open developer portal</a></td></tr></table><p style=\"margin:20px 0 0;line-height:1.6;font-size:13px;color:#6b7a73\">Your balance and API keys are available in the developer portal.</p></td></tr><tr><td style=\"padding:18px 32px;border-top:1px solid #e5e7eb;background:#f9fafb;border-radius:0 0 12px 12px\"><p style=\"margin:0;font-size:12px;color:#6b7a73;line-height:1.6\">Questions? <a href=\"mailto:welcome@openopps.com\" style=\"color:#034737;text-decoration:underline\">Contact our team</a>.</p></td></tr></table><p style=\"margin:16px 0 0;font-size:11px;color:#8a988f;text-align:center\">Open Opportunities</p></td></tr></table></body></html>"
}
