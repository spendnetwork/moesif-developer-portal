ef=\"{{teamUrl}}\" style=\"display:inline-block;padding:12px 24px;color:#ffffff;font-size:15px;font-weight:bold;text-decoration:none\">View your team</a></td></tr></table><p style=\"margin:20px 0 0;line-height:1.6;font-size:13px;color:#6b7a73\">Not expecting this? Contact our team and we'll suspend their access.</p></td></tr><tr><td style=\"padding:18px 32px;border-top:1px solid #e5e7eb;background:#f9fafb;border-radius:0 0 12px 12px\"><p style=\"margin:0;font-size:12px;color:#6b7a73;line-height:1.6\">Questions? <a href=\"mailto:welcome@openopps.com\" style=\"color:#034737;text-decoration:underline\">Contact our team</a>.</p></td></tr></table><p style=\"margin:16px 0 0;font-size:11px;color:#8a988f;text-align:center\">Open Opportunities</p></td></tr></table></body></html>"
