FRONT_END_DOMAIN=127.0.0.1:4000

########################
# Moesif Configuration #
########################
MOESIF_APPLICATION_ID=
MOESIF_MANAGEMENT_TOKEN=
# The Management API token must include at least:
#   create:billing_meters, create:billing_reports,
#   read:billing_meters, read:billing_reports, read:events
# plus the read/create scopes used for plans, subscriptions, companies, users,
# and embedded workspaces.
MOESIF_TEMPLATE_WORKSPACE_ID_LIVE_EVENT_LOG=
MOESIF_TEMPLATE_WORKSPACE_ID_TIME_SERIES=

# Only change to V1 if you're using an old version of Moesif monetization data model.
MOESIF_MONETIZATION_VERSION="V2"

###################################
# Identity Provider Configuration #
###################################

# The portal authenticates with Auth0. Tokens are verified against Auth0's
# published JWKS, i.e. asymmetric keys / the RS256 algorithm.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=

# Optional: a Machine-to-Machine app authorized for the Auth0 Management API
# (scopes: update:users / create:user_tickets). Used only to resend the
# email-verification message from the terms gate. Leave blank to disable the
# resend button (the endpoint then returns 503 "not configured").
AUTH0_MANAGEMENT_CLIENT_ID=
AUTH0_MANAGEMENT_CLIENT_SECRET=

#########################
# Billing Configuration #
#########################

# Only Stripe is supported. Required for credit card check out.
APP_PAYMENT_PROVIDER=stripe
STRIPE_API_KEY=

# REQUIRED for subscription enforcement. Without this the /stripe/webhook
# endpoint returns 503 and a cancelled customer KEEPS A WORKING API KEY.
# The Stripe endpoint must subscribe to at least:
#   checkout.session.completed                (initial provisioning fallback)
#   checkout.session.async_payment_succeeded  (delayed payment methods)
#   invoice.paid, invoice.payment_failed     (plan changes and commitments)
#   customer.subscription.created
#   customer.subscription.deleted
#   customer.subscription.updated
#   customer.subscription.paused             (API key revocation)
PORTAL_STRIPE_WEBHOOK_SECRET=

# Safety net for missed/delayed Stripe webhooks. Webhooks remain the primary path.
# Minimum 60000 milliseconds; recommended production value is 300000 (5 minutes).
PLAN_CHANGE_RECONCILIATION_INTERVAL_MS=300000
PLAN_CHANGE_RECONCILIATION_LEASE_SECONDS=300
# Reviewed commitment invoices are sent rather than charged automatically.
PLAN_CHANGE_INVOICE_DAYS=14

# Growth and Enterprise cannot be purchased by card checkout. Customers are
# directed here so the team can agree terms and issue an invoice manually.
SALES_CONTACT_EMAIL=contact@spendnetwork.com

# Service token shared only with the internal admin tool. It authorizes manual
# commitment creation and payment confirmation; it must not be exposed to the
# browser.
ADMIN_PLAN_CHANGE_TOKEN=

# Custom-provider Moesif catalogue IDs for externally invoiced commitments.
# Each price list must contain exactly four IDs in this order-independent set:
# API calls, records returned, aggregate calls, and attachments.

#################################
# Spend Network API Provisioning #
#################################

SN_API_BASE_URL=https://api-dev.spendnetwork.cloud
SN_API_PROVISIONING_TOKEN=
SN_API_REQUEST_TIMEOUT_MS=10000
SALES_CONTACT_EMAIL=welcome@openopps.com

# Customer invitations. Enable only after the API migration, SendGrid
# verified sender and Slack webhook are ready. Never expose these to Vite.
INVITATIONS_ENABLED=false
INVITATION_SIGNING_SECRET=
INVITATION_PORTAL_URL=http://127.0.0.1:4000
SENDGRID_API_KEY=
EMAIL_FROM=welcome@openopps.com
EMAIL_FROM_NAME=Open Opportunities
INVITATION_SLACK_WEBHOOK_URL=
# Enable only after the SN API migration and Stripe webhook configuration.
# These are Stripe price_ identifiers, not Moesif IDs or usage/metered prices.
STRIPE_WALLET_SUBSCRIPTIONS_ENABLED=false
STRIPE_WALLET_BASIC_PRICE_ID=
STRIPE_WALLET_GROWTH_PRICE_ID=
STRIPE_WALLET_ENTERPRISE_PRICE_ID=
# Customer and internal account notifications. Apply the SN API migration first.
# Falls back to INVITATIONS_ENABLED when unset; explicit false pauses this worker.
CUSTOMER_NOTIFICATIONS_ENABLED=false
# Slack incoming webhook for internal account/credit alerts; falls back to INVITATION_SLACK_WEBHOOK_URL.
NOTIFICATION_SLACK_WEBHOOK_URL=
# Admin UI origin for the customer/invitation buttons in all staff Slack alerts.
# Set the deployed admin URL in each environment; loopback HTTP is allowed locally only.
ADMIN_PORTAL_BASE_URL=http://127.0.0.1:5173
# Base64 public verification key for the SIGNED SendGrid Event Webhook, not an API key.
SENDGRID_EVENT_WEBHOOK_PUBLIC_KEY=
